# --- Telegram ---
BOT_TOKEN=
# Бот работает через long polling, вебхук на этом этапе не используется.

# --- База данных ---
POSTGRES_USER=pullup
POSTGRES_PASSWORD=pullup
POSTGRES_DB=pullup
POSTGRES_HOST=db
# Порт для доступа к БД с хоста, если раскомментируете ports в docker-compose.yml
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pullup:pullup@db:5432/pullup

# --- FSM-хранилище состояний диалога (обязательно Redis, не in-memory) ---
REDIS_URL=redis://redis:6379/0

# --- Прочее ---
LOG_LEVEL=INFO
ADMIN_IDS=
# Ссылка на сводную Google-таблицу с участниками/отчётами — кнопка в /admin.
ADMIN_SHEET_URL=
TRIBUTE_API_KEY=

# --- Робокасса (запасной канал оплаты картой, параллельно с Tribute) ---
# Все поля пустые -> кнопка "Картой (Робокасса)" на пейволле скрыта,
# воркер robokassa_sync тихо ничего не делает. Пароль №2 — отдельный от
# №1, нужен именно для проверки статуса платежа (OpStateExt), без него
# оплата пройдёт, но никогда не подтвердится автоматически.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=

# --- Выгрузка событий/пользователей в Google Sheets (app/workers/sheets_sync.py) ---
# Оба поля пустые -> воркер тихо ничего не делает. Путь — внутри контейнера
# (см. volumes в docker-compose.yml), ключ сервисного аккаунта на хосте
# должен лежать в ./secrets/ с правами chmod 600.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_PATH=/app/secrets/google-sheets-service-account.json
