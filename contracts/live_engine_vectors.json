           {"kind": "max_reps", "target": null, "rest_after_seconds": null}
         ]},
        {"kind": "sets", "prep_seconds": 5, "rest_after_block_seconds": null, "extra_sets_allowed": true,
         "sets": [
           {"kind": "time", "target": 30, "rest_after_seconds": 20},
