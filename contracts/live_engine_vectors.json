  "cases": [
    {
      "name": "basic normal workout: auto PREP->WORK, auto REST->WORK, three sets, COMPLETE",
      "plan": "basic", "start_at": 0, "rebuild": true,
      "start_expect": {"status": "active", "phase": "PREP", "phase_seq": 0, "phase_deadline_at": 5000,
                       "cursor": {"block_index": 0, "set_index": 0, "round_index": null}},
      "steps": [
        {"op": "project", "now": 4999, "expect": {"phase": "PREP", "phase_seq": 0}, "expect_events": []},
        {"op": "project", "now": 5000,
         "expect": {"phase": "WORK", "phase_seq": 1, "phase_started_at": 5000, "phase_deadline_at": null},
         "expect_events": [{"type": "deadline", "at": 5000}]},
        {"op": "apply", "at": 20000,
         "event": {"type": "submit_result", "payload": {"block_index": 0, "set_index": 0, "round_index": null, "value": 10}},
         "expect": {"phase": "REST", "rest_kind": "set", "phase_seq": 2, "phase_deadline_at": 80000,
                    "cursor": {"block_index": 0, "set_index": 0, "round_index": null},
                    "logs": [{"block_index": 0, "set_index": 0, "value": 10, "is_extra": false, "log_index": 0}]},
         "expect_effects": [{"type": "set_logged", "log": {"set_index": 0, "value": 10}}]},
        {"op": "project", "now": 80000,
         "expect": {"phase": "WORK", "phase_seq": 3, "phase_started_at": 80000,
                    "cursor": {"block_index": 0, "set_index": 1, "round_index": null}}},
        {"op": "apply", "at": 90000,
         "event": {"type": "submit_result", "payload": {"block_index": 0, "set_index": 1, "round_index": null, "value": 9}},
         "expect": {"phase": "REST", "phase_seq": 4, "phase_deadline_at": 150000}},
        {"op": "apply", "at": 160000,
         "event": {"type": "submit_result", "payload": {"block_index": 0, "set_index": 2, "round_index": null, "value": 8}},
         "expect": {"status": "completed", "phase": "COMPLETE", "phase_seq": 6, "phase_deadline_at": null,
                    "active_elapsed_ms": 160000, "ended_at": 160000,
                    "logs": [{"value": 10}, {"value": 9}, {"value": 8}]},
         "expect_events": [{"type": "deadline", "at": 150000}],
         "expect_effects": [
           {"type": "set_logged", "log": {"set_index": 2, "value": 8}},
           {"type": "block_finished", "block_index": 0, "started_at": 0, "at": 160000},
           {"type": "completed", "abandoned": false, "active_elapsed_ms": 160000}
         ]}
      ]
    },
