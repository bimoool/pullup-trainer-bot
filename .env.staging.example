# Пример .env для staging-контура (issue: настройка staging перед волной 4
# многокурсовой платформы). Копируется в /opt/pullup-trainer-bot-staging/.env
# ОДИН РАЗ ВРУЧНУЮ на сервере (deploy-staging.yml намеренно не создаёт его
# автоматически — см. комментарий в workflow) — с реальными значениями
# вместо плейсхолдеров ниже.
#
# Отличия от прод-.env — только эти четыре поля, остальное как в
# .env.example (Robokassa/Sheets/дайджест можно оставить пустыми на
# staging, они не нужны для проверки веток):

# Токен ОТДЕЛЬНОГО тестового бота, заведённого через @BotFather
# (не токен боевого бота!) — иначе staging и прод будут отвечать в одном
# и том же чате с пользователями.
BOT_TOKEN=

# Отдельное имя БД — вместе с docker compose -p pullup-staging (project
# name в deploy-staging.yml) гарантирует, что staging физически не может
# задеть прод-данные, даже при ошибке конфигурации.
POSTGRES_USER=pullup_staging
POSTGRES_PASSWORD=pullup_staging
POSTGRES_DB=pullup_staging
DATABASE_URL=postgresql+asyncpg://pullup_staging:pullup_staging@db:5432/pullup_staging

REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
ADMIN_IDS=

# HTTPS-адрес staging-поддомена (заводится отдельно — см. инструкцию по
# nginx/DNS, которую нужно применить на сервере вручную).
MINI_APP_URL=https://staging.app.bimoool.com

# Порт, зафиксированный соглашением в deploy-staging.yml (health-check
# внутри workflow бьёт именно в 8002) — не менять без правки workflow.
MINI_APP_PORT=8002
