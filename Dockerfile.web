FROM node:20-alpine AS frontend-build

WORKDIR /frontend

COPY webapp-frontend/package.json ./
RUN npm install

COPY webapp-frontend ./
RUN npm run build

FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml ./
COPY app ./app

RUN pip install --no-cache-dir .[web]

# Собранная статика фронтенда — сайд-каром рядом с app/, не внутри пакета
# (см. app/web/main.py::STATIC_DIR). Основной Dockerfile бота этот файл не
# трогает и не пересобирается при изменениях здесь.
COPY --from=frontend-build /frontend/dist ./webapp-frontend/dist

CMD ["uvicorn", "app.web.main:app", "--host", "0.0.0.0", "--port", "8000"]
